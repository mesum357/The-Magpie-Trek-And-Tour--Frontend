<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Certifications</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=HK+Grotesk:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/styles/home.css">
  <style>
    body {
      background: #f7f9ff;
      font-family: 'HK Grotesk', ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    }

    .certifications-section {
      padding-top: 120px;
      padding-bottom: 60px;
    }

    .section-title {
      font-weight: 700;
      color: #1f2937;
    }

    .section-subtitle {
      color: #6b7280;
      max-width: 780px;
    }

    .certificate-card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      overflow: hidden;
      background: #fff;
      height: 100%;
    }

    .certificate-card-clickable {
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .certificate-card-clickable:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
    }

    .certificate-image-wrap {
      background: #f3f4f6;
      height: 280px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .certificate-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #fff;
    }

    .certificate-body {
      padding: 1rem 1.1rem 1.2rem;
    }

    .certificate-title {
      margin-bottom: 0.35rem;
      font-size: 1.05rem;
      font-weight: 700;
      color: #111827;
    }

    .certificate-note {
      color: #6b7280;
      margin-bottom: 0;
      font-size: 0.92rem;
    }

    .secp-preview {
      flex-direction: column;
      gap: 0.75rem;
      color: #198754;
      border: 0;
      background: #f3f4f6;
      width: 100%;
      padding: 0;
    }

    .secp-preview i {
      font-size: 3rem;
    }

    .secp-preview span {
      font-weight: 600;
      color: #374151;
    }

    .certificate-modal {
      position: fixed;
      inset: 0;
      z-index: 10050;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.92);
      padding: 1rem;
    }

    .certificate-modal.is-open {
      display: flex;
    }

    .certificate-modal-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      z-index: 2;
      width: 44px;
      height: 44px;
      border: none;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      font-size: 1.75rem;
      line-height: 1;
      cursor: pointer;
    }

    .certificate-modal-close:hover {
      background: rgba(255, 255, 255, 0.28);
    }

    .certificate-modal-content {
      width: 100%;
      height: 100%;
      max-width: 1200px;
      max-height: calc(100vh - 2rem);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .certificate-modal-content img,
    .certificate-modal-content iframe {
      max-width: 100%;
      max-height: calc(100vh - 2rem);
      width: 100%;
      height: calc(100vh - 2rem);
      border: none;
      border-radius: 8px;
      object-fit: contain;
      background: #fff;
    }

    .certificate-modal-content img {
      width: auto;
      height: auto;
    }
  </style>
</head>

<body>
  <%- include('partials/navbar', { user: user, isAuthenticated: isAuthenticated, currentPage: 'certifications' }) %>
    <%- include('partials/language-script') %>

      <section class="certifications-section">
        <div class="container">
          <div class="text-center mb-5">
            <h1 class="section-title">Certifications</h1>
            <p class="section-subtitle mx-auto">
              We value transparency and compliance. Explore our official registration and supporting certificates below.
            </p>
          </div>

          <div class="row g-4 mb-2">
            <div class="col-12">
              <div class="certificate-card">
                <div class="certificate-body">
                  <h3 class="certificate-title">
                    SECURITIES AND EXCHANGE COMMISSION OF PAKISTAN (SECP) Certificate
                  </h3>
                  <p class="certificate-note">
                    Certificate of Incorporation
                  </p>
                </div>
                <button type="button" class="secp-preview certificate-card-clickable" data-certificate-type="pdf"
                  data-certificate-src="/images/certificates/Certificate%20of%20Incorporation.pdf"
                  aria-label="View SECP certificate">
                  <div class="certificate-image-wrap">
                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                    <span>Click to view full certificate</span>
                  </div>
                </button>
              </div>
            </div>
          </div>

          <div class="row g-4">
            <div class="col-lg-4 col-md-6">
              <div class="certificate-card certificate-card-clickable" role="button" tabindex="0"
                data-certificate-type="image"
                data-certificate-src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.13%20PM.jpeg"
                aria-label="View certificate">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.13%20PM.jpeg" alt="">
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="certificate-card certificate-card-clickable" role="button" tabindex="0"
                data-certificate-type="image"
                data-certificate-src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.14%20P.jpeg"
                aria-label="View certificate">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.14%20P.jpeg" alt="">
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="certificate-card certificate-card-clickable" role="button" tabindex="0"
                data-certificate-type="image"
                data-certificate-src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.14%20PM.jpeg"
                aria-label="View certificate">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.14%20PM.jpeg" alt="">
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="certificate-card certificate-card-clickable" role="button" tabindex="0"
                data-certificate-type="image"
                data-certificate-src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.15%20PM.jpeg"
                aria-label="View certificate">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.15%20PM.jpeg" alt="">
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="certificate-card certificate-card-clickable" role="button" tabindex="0"
                data-certificate-type="image"
                data-certificate-src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.16%20PM.jpeg"
                aria-label="View certificate">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.16%20PM.jpeg" alt="">
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="certificate-card certificate-card-clickable" role="button" tabindex="0"
                data-certificate-type="image"
                data-certificate-src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.19%20PM.jpeg"
                aria-label="View certificate">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.19%20PM.jpeg" alt="">
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div id="certificateModal" class="certificate-modal" role="dialog" aria-modal="true"
        aria-label="Certificate viewer" hidden>
        <button type="button" class="certificate-modal-close" id="certificateModalClose"
          aria-label="Close">&times;</button>
        <div class="certificate-modal-content" id="certificateModalContent"></div>
      </div>

      <%- include('partials/footer') %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
          (function () {
            const modal = document.getElementById('certificateModal');
            const modalContent = document.getElementById('certificateModalContent');
            const closeBtn = document.getElementById('certificateModalClose');
            const triggers = document.querySelectorAll('[data-certificate-type][data-certificate-src]');

            function closeModal() {
              modal.classList.remove('is-open');
              modal.hidden = true;
              modalContent.innerHTML = '';
              document.body.style.overflow = '';
            }

            function openModal(type, src) {
              modalContent.innerHTML = '';

              if (type === 'pdf') {
                const iframe = document.createElement('iframe');
                iframe.src = src;
                iframe.title = 'Certificate PDF';
                modalContent.appendChild(iframe);
              } else {
                const img = document.createElement('img');
                img.src = src;
                img.alt = 'Certificate';
                modalContent.appendChild(img);
              }

              modal.hidden = false;
              modal.classList.add('is-open');
              document.body.style.overflow = 'hidden';
              closeBtn.focus();
            }

            triggers.forEach(function (el) {
              el.addEventListener('click', function () {
                openModal(el.dataset.certificateType, el.dataset.certificateSrc);
              });

              el.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                  e.preventDefault();
                  openModal(el.dataset.certificateType, el.dataset.certificateSrc);
                }
              });
            });

            closeBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', function (e) {
              if (e.target === modal) closeModal();
            });
            document.addEventListener('keydown', function (e) {
              if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
            });
          })();
        </script>
</body>

</html>
