<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Certifications</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=HK+Grotesk:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/styles/home.css">
  <style>
    body {
      background: #f7f9ff;
      font-family: 'HK Grotesk', ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    }

    .certifications-section {
      padding-top: 120px;
      padding-bottom: 60px;
    }

    .section-title {
      font-weight: 700;
      color: #1f2937;
    }

    .section-subtitle {
      color: #6b7280;
      max-width: 780px;
    }

    .certificate-card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      overflow: hidden;
      background: #fff;
      height: 100%;
    }

    .certificate-image-wrap {
      background: #f3f4f6;
      height: 280px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .certificate-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .certificate-body {
      padding: 1rem 1.1rem 1.2rem;
    }

    .certificate-title {
      margin-bottom: 0.35rem;
      font-size: 1.05rem;
      font-weight: 700;
      color: #111827;
    }

    .certificate-note {
      color: #6b7280;
      margin-bottom: 0.9rem;
      font-size: 0.92rem;
    }
  </style>
</head>

<body>
  <%- include('partials/navbar', { user: user, isAuthenticated: isAuthenticated, currentPage: 'certifications' }) %>
    <%- include('partials/language-script') %>

      <section class="certifications-section">
        <div class="container">
          <div class="text-center mb-5">
            <h1 class="section-title">Certifications</h1>
            <p class="section-subtitle mx-auto">
              We value transparency and compliance. Explore our official registration and supporting certificates below.
            </p>
          </div>

          <div class="row g-4 mb-2">
            <div class="col-12">
              <div class="certificate-card">
                <div class="certificate-body">
                  <h3 class="certificate-title">
                    SECURITIES AND EXCHANGE COMMISSION OF PAKISTAN (SECP) Certificate
                  </h3>
                  <p class="certificate-note">
                    Certificate of Incorporation
                  </p>
                  <a class="btn btn-success" href="/images/certificates/Certificate%20of%20Incorporation.pdf" target="_blank" rel="noopener">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Open PDF
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-4">
            <div class="col-lg-4 col-md-6">
              <div class="certificate-card">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.13%20PM.jpeg" alt="Certificate image 1">
                </div>
                <div class="certificate-body">
                  <h3 class="certificate-title">Supporting Certificate 1</h3>
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="certificate-card">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.14%20P.jpeg" alt="Certificate image 2">
                </div>
                <div class="certificate-body">
                  <h3 class="certificate-title">Supporting Certificate 2</h3>
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="certificate-card">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.14%20PM.jpeg" alt="Certificate image 3">
                </div>
                <div class="certificate-body">
                  <h3 class="certificate-title">Supporting Certificate 3</h3>
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="certificate-card">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.15%20PM.jpeg" alt="Certificate image 4">
                </div>
                <div class="certificate-body">
                  <h3 class="certificate-title">Supporting Certificate 4</h3>
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="certificate-card">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.16%20PM.jpeg" alt="Certificate image 5">
                </div>
                <div class="certificate-body">
                  <h3 class="certificate-title">Supporting Certificate 5</h3>
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6">
              <div class="certificate-card">
                <div class="certificate-image-wrap">
                  <img src="/images/certificates/WhatsApp%20Image%202026-04-29%20at%2010.02.19%20PM.jpeg" alt="Certificate image 6">
                </div>
                <div class="certificate-body">
                  <h3 class="certificate-title">Supporting Certificate 6</h3>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <%- include('partials/footer') %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
